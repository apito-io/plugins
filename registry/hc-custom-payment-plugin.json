  "contributions": {
    "api": {
      "scope": "project",
      "mutations": [
        {
          "name": "customInitialize",
          "description": "Custom payments are recorded by webhook"
        },
        {
          "name": "customVerify",
          "description": "Custom payments are recorded by webhook"
        },
        {
          "name": "customWebhook",
          "description": "Record a custom payment webhook"
        },
        {
          "name": "customCancel",
          "description": "End a custom subscription now"
        },
        {
          "name": "customRotateSecret",
          "description": "Generate a new webhook secret"
        }
      ],
      "rest": [
        {
          "method": "GET",
          "path": "/config",
          "description": "Non-secret custom payment flags"
        }
      ]
    },
    "ui": {
      "ui_available": true,
      "navigation": [
        {
          "hidden": true,
          "settings": true,
          "label": "Custom"
        }
      ]
    }
