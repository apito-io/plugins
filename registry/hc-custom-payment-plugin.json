{
  "id": "hc-custom-payment-plugin",
  "name": "Custom",
  "publisher": "Apito",
  "repository": "https://github.com/apito-io/hc-custom-payment-plugin",
  "license": "Apache-2.0",
  "description": "Record a tenant subscription from a signed webhook or the logged-in app.",
  "long_description": "The engine install is shared. Each project stores its own webhook secret. Callers send X-Apito-Webhook-Secret. The logged-in app can submit without that header.",
  "icon": "",
  "tags": ["custom", "payment", "webhook"],
  "category": "payments",
  "language": "go",
  "capabilities": ["project.graphql", "project.rest", "console.settings"],
  "engine_semver": ">=2.4.0",
  "plugin_version": "0.1.0",
  "trust": "official",
  "status": "available",
  "documentation_url": "/docs/platform/plugins/",
  "runtime": {
    "id": "hc-custom-payment-plugin",
    "version": "0.1.0",
    "binary_path": "hc-custom-payment-plugin",
    "capabilities": ["project.graphql", "project.rest", "console.settings"],
    "handshake": {
      "protocol_version": 1,
      "magic_cookie_key": "APITO_PLUGIN",
      "magic_cookie_value": "apito_plugin_magic_cookie_v1"
    }
  },
  "contributions": {
    "api": {
      "scope": "project",
      "mutations": [
        { "name": "customInitialize", "description": "Custom payments are recorded by webhook" },
        { "name": "customVerify", "description": "Custom payments are recorded by webhook" },
        { "name": "customWebhook", "description": "Record a custom payment webhook" },
        { "name": "customCancel", "description": "End a custom subscription now" },
        { "name": "customRotateSecret", "description": "Generate a new webhook secret" }
      ],
      "rest": [
        { "method": "GET", "path": "/config", "description": "Non-secret custom payment flags" }
      ]
    },
    "ui": {
      "ui_available": true,
      "navigation": [{ "hidden": true, "settings": true, "label": "Custom" }]
    }
  },
  "releases": [],
  "approval": { "reviewed_by": "apito", "reviewed_at": "2026-11-09" }
}
