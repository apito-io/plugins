{
  "id": "hc-cloudinary-plugin",
  "name": "Cloudinary",
  "publisher": "Apito",
  "repository": "https://github.com/apito-io/hc-cloudinary-plugin",
  "license": "Apache-2.0",
  "description": "Cloudinary media library beside Files.",
  "long_description": "Signed uploads, asset list, and delete via Cloudinary. Console library page appears after activation. Does not replace S3 Files.",
  "icon": "",
  "tags": [
    "cloudinary",
    "media",
    "images"
  ],
  "category": "storage",
  "language": "go",
  "capabilities": [
    "project.graphql",
    "project.rest",
    "console.routes",
    "console.settings",
    "content.fields"
  ],
  "engine_semver": ">=2.4.0",
  "plugin_version": "0.0.4",
  "trust": "official",
  "status": "available",
  "documentation_url": "/docs/platform/plugins/",
  "runtime": {
    "id": "hc-cloudinary-plugin",
    "version": "0.0.4",
    "binary_path": "hc-cloudinary-plugin",
    "capabilities": [
      "project.graphql",
      "project.rest",
      "console.routes",
      "console.settings",
      "content.fields"
    ],
    "handshake": {
      "protocol_version": 1,
      "magic_cookie_key": "APITO_PLUGIN",
      "magic_cookie_value": "apito_plugin_magic_cookie_v1"
    }
  },
  "contributions": {
    "api": {
      "scope": "project",
      "queries": [
        { "name": "cloudinaryAssets", "description": "List Cloudinary assets for this project" }
      ],
      "mutations": [
        { "name": "cloudinarySignUpload", "description": "Sign a Cloudinary upload for this project" }
      ],
      "rest": [
        { "method": "GET", "path": "/assets", "description": "List assets" },
        { "method": "POST", "path": "/sign", "description": "Sign upload" },
        { "method": "POST", "path": "/delete", "description": "Delete asset" }
      ]
    },
    "ui": {
      "ui_available": true,
      "routes": [{ "path": "/", "title": "Cloudinary" }],
      "navigation": [
        {
          "after": "storage",
          "label": "Cloudinary",
          "path": "/console/plugin/hc-cloudinary-plugin"
        }
      ],
      "settings": [
        {
          "path": "/console/settings/plugins/hc-cloudinary-plugin",
          "label": "Cloudinary"
        }
      ]
    },
    "fields": [
      {
        "id": "cloudinary_asset",
        "label": "Cloudinary Asset",
        "icon": "image",
        "storage_type": "media",
        "form_component": "CloudinaryAssetPicker",
        "display_component": "CloudinaryAssetPreview",
        "content_form": true
      }
    ]
  },
