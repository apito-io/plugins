  "license": "Apache-2.0",
  "description": "EPS hosted checkout for SaaS tenant plans. Credentials stay on the project.",
  "long_description": "The engine install is shared. Each project activates EPS and stores its own username, password, hash key, merchant id, and store id. The public review page is rendered by the plugin. The shop return URL stays on the checkout.",
  "icon": "",
  "tags": [
    "eps",
    "payment",
    "checkout"
  ],
  "category": "payments",
  "language": "go",
