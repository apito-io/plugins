    "capabilities": [
      "project.graphql",
      "project.rest",
      "console.settings"
    ],
    "handshake": {
      "protocol_version": 1,
      "magic_cookie_key": "APITO_PLUGIN",
      "magic_cookie_value": "apito_plugin_magic_cookie_v1"
    }
  },
  "contributions": {
    "api": {
      "scope": "project",
      "mutations": [
        {
          "name": "epsInitialize",
          "description": "Start EPS hosted checkout for this project"
        },
        {
          "name": "epsVerify",
          "description": "Verify an EPS merchant transaction for this project"
        },
        {
          "name": "epsReview",
          "description": "Render the public EPS review page for this project"
        }
      ],
      "rest": [
        {
          "method": "GET",
          "path": "/config",
          "description": "Non-secret EPS configuration flags"
        }
      ]
    },
    "ui": {
      "ui_available": true,
      "navigation": [
        {
          "hidden": true,
          "settings": true,
          "label": "EPS"
        }
      ]
    }
  },
